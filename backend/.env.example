# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas)
# Local example: mongodb://127.0.0.1:27017/meghora
# Atlas example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/meghora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/meghora

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Weather Telemetry Service
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
